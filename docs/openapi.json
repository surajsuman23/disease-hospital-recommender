{
  "openapi": "3.1.0",
  "info": {
    "title": "Arovia Research API",
    "version": "2.0.0",
    "description": "Real disease categories learned from simulated DDXPlus cases. Research use only. Not clinical probabilities or diagnoses. No prediction records saved."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Ready; includes requestBudget local/distributed"
          },
          "503": {
            "description": "Budget database unavailable"
          }
        }
      }
    },
    "/api/v1/model": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "demoOnly": {
                      "type": "boolean",
                      "const": true
                    },
                    "algorithm": {
                      "type": "string"
                    },
                    "symptoms": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "question": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "common": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "question",
                          "group",
                          "common"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "icd10": {
                            "type": "string"
                          },
                          "symptoms": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "name",
                          "icd10",
                          "symptoms"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "dataset": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "format": "uri"
                    },
                    "holdoutAccuracy": {
                      "type": "number"
                    },
                    "holdoutMacroF1": {
                      "type": "number"
                    },
                    "top3Accuracy": {
                      "type": "number"
                    },
                    "threeSymptomAccuracy": {
                      "type": "number"
                    },
                    "threeSymptomTop3": {
                      "type": "number"
                    },
                    "trainRows": {
                      "type": "number"
                    },
                    "testRows": {
                      "type": "number"
                    },
                    "privacy": {
                      "type": "string"
                    },
                    "notice": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "demoOnly",
                    "algorithm",
                    "symptoms",
                    "conditions",
                    "dataset",
                    "source",
                    "holdoutAccuracy",
                    "holdoutMacroF1",
                    "top3Accuracy",
                    "threeSymptomAccuracy",
                    "threeSymptomTop3",
                    "trainRows",
                    "testRows",
                    "privacy",
                    "notice"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hospitals": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "hospitals": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "address": {
                            "type": "string"
                          },
                          "latitude": {
                            "type": "number"
                          },
                          "longitude": {
                            "type": "number"
                          },
                          "fictional": {
                            "type": "boolean",
                            "const": false
                          },
                          "website": {
                            "type": "string",
                            "format": "uri"
                          },
                          "mapUrl": {
                            "type": "string",
                            "format": "uri"
                          },
                          "area": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "verifiedOn": {
                            "type": "string"
                          },
                          "distanceKm": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "address",
                          "latitude",
                          "longitude",
                          "fictional",
                          "website",
                          "mapUrl",
                          "area",
                          "source",
                          "verifiedOn"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "hospitals"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions": {
      "post": {
        "summary": "Rank disease research candidates from 3–30 selected positive symptoms",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "symptoms": {
                    "minItems": 3,
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "E_9",
                        "E_13",
                        "E_14",
                        "E_23",
                        "E_30",
                        "E_32",
                        "E_33",
                        "E_38",
                        "E_39",
                        "E_42",
                        "E_43",
                        "E_45",
                        "E_50",
                        "E_51",
                        "E_52",
                        "E_53",
                        "E_63",
                        "E_64",
                        "E_65",
                        "E_66",
                        "E_67",
                        "E_74",
                        "E_75",
                        "E_76",
                        "E_77",
                        "E_82",
                        "E_83",
                        "E_84",
                        "E_88",
                        "E_89",
                        "E_90",
                        "E_91",
                        "E_92",
                        "E_93",
                        "E_94",
                        "E_96",
                        "E_97",
                        "E_103",
                        "E_111",
                        "E_112",
                        "E_114",
                        "E_127",
                        "E_128",
                        "E_129",
                        "E_140",
                        "E_144",
                        "E_145",
                        "E_148",
                        "E_150",
                        "E_151",
                        "E_154",
                        "E_155",
                        "E_156",
                        "E_157",
                        "E_159",
                        "E_161",
                        "E_162",
                        "E_163",
                        "E_164",
                        "E_166",
                        "E_168",
                        "E_169",
                        "E_170",
                        "E_171",
                        "E_172",
                        "E_173",
                        "E_174",
                        "E_175",
                        "E_176",
                        "E_177",
                        "E_178",
                        "E_179",
                        "E_180",
                        "E_181",
                        "E_182",
                        "E_188",
                        "E_190",
                        "E_192",
                        "E_193",
                        "E_194",
                        "E_201",
                        "E_202",
                        "E_203",
                        "E_205",
                        "E_206",
                        "E_210",
                        "E_211",
                        "E_212",
                        "E_214",
                        "E_215",
                        "E_216",
                        "E_217",
                        "E_218",
                        "E_219",
                        "E_220",
                        "E_221"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "location": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ],
                    "additionalProperties": false
                  },
                  "hospitalLimit": {
                    "default": 3,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                },
                "required": [
                  "symptoms"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "requestId": {
                      "type": "string"
                    },
                    "modelVersion": {
                      "type": "string"
                    },
                    "demoOnly": {
                      "type": "boolean",
                      "const": true
                    },
                    "label": {
                      "type": "string"
                    },
                    "scores": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "score": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "matchedSymptoms": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "icd10": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "label",
                          "score",
                          "matchedSymptoms",
                          "icd10"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "hospitals": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "address": {
                            "type": "string"
                          },
                          "latitude": {
                            "type": "number"
                          },
                          "longitude": {
                            "type": "number"
                          },
                          "fictional": {
                            "type": "boolean",
                            "const": false
                          },
                          "website": {
                            "type": "string",
                            "format": "uri"
                          },
                          "mapUrl": {
                            "type": "string",
                            "format": "uri"
                          },
                          "area": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "verifiedOn": {
                            "type": "string"
                          },
                          "distanceKm": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "address",
                          "latitude",
                          "longitude",
                          "fictional",
                          "website",
                          "mapUrl",
                          "area",
                          "source",
                          "verifiedOn"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "rankingIncluded": {
                      "type": "boolean"
                    },
                    "selectedSymptoms": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "notice": {
                      "type": "string"
                    },
                    "evidenceLevel": {
                      "type": "string",
                      "enum": [
                        "limited",
                        "expanded"
                      ]
                    },
                    "createdAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "requestId",
                    "modelVersion",
                    "demoOnly",
                    "label",
                    "scores",
                    "hospitals",
                    "rankingIncluded",
                    "selectedSymptoms",
                    "notice",
                    "evidenceLevel",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON"
          },
          "403": {
            "description": "Origin not allowed"
          },
          "413": {
            "description": "Body exceeds 4 KB"
          },
          "415": {
            "description": "JSON required"
          },
          "422": {
            "description": "Invalid/unknown/duplicate/insufficient features"
          },
          "429": {
            "description": "Aggregate request budget exceeded"
          },
          "503": {
            "description": "Shared budget database unavailable"
          }
        }
      }
    }
  }
}
